[Unit]
Description=Jypyter Hub daemon
After=network.target
Before=nginx.service

[Service]
Type=simple
ExecStart={{ jupyterhub_venv }}/bin/jupyterhub --config={{ jupyterhub_config_dir }}/jupyterhub_config.py
Restart=on-failure
RestartSec=10s
User={{ jupyterhub_user }}
Environment=PATH=/usr/local/bin:{{ jupyterhub_venv }}/bin:/usr/bin/:/bin
{% if jupyterhub_enable_unix_socket %}
RuntimeDirectory={{ jupyterhub_rundir }}
ExecStartPre=+-/usr/bin/rm -f {{ jupyterhub_public_rundir }}/jupyterhub-api.sock
{% endif %}
[Install]
WantedBy=multi-user.target
WantedBy=nginx.service
