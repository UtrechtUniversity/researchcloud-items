[Unit]
Description={{ ray_service_name | capitalize }}
After=network.target

[Service]
Type=exec
User=ray
EnvironmentFile=/home/ray/{{ ray_service_name }}.env
Environment="PATH={{ ray_venv }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

{% if ray_head_node %}
ExecStart={{ ray_cmd }} start \
    --disable-usage-stats \
    --block \
    --node-ip-address "$RAY_NODE_IP_ADDRESS" \
    --head {% if ray_no_cpu %}--num-cpus=0 {% endif %}\
    --port "$RAY_PORT" \
    --dashboard-host="{{ ray_dashboard_host }}" \
    --dashboard-port "$RAY_DASHBOARD_PORT" \
    --ray-client-server-port "$RAY_CLIENT_SERVER_PORT" \
    --temp-dir /tmp/{{ ray_service_name }} \
    --dashboard-agent-listen-port=52365 \
    --runtime-env-agent-port=52366{%- if 'molecule-notest' in ansible_skip_tags -%} \
        --min-worker-port=20000 \
        --max-worker-port=20099 \
        --node-manager-port=6380 \
        --object-manager-port=6381{%- endif %}
{% else %}
ExecStart={{ ray_cmd }} start \
    --disable-usage-stats \
    --block \
    --node-ip-address "$RAY_NODE_IP_ADDRESS" \
    --address "$RAY_ADDRESS" \
    --temp-dir /tmp/{{ ray_service_name }} \
    --dashboard-agent-listen-port=52367 \
    --runtime-env-agent-port=52368{%- if 'molecule-notest' in ansible_skip_tags -%} \
        --min-worker-port=20100 \
        --max-worker-port=20199 \
        --node-manager-port=6382 \
        --object-manager-port=6383{%- endif %}
{% endif %}

ExecStop=/usr/local/bin/uv tool run ray stop
# The first stop sometimes doesn't end all processes, so try harder:
ExecStop=/usr/local/bin/uv tool run ray stop --force
ExecStopPost=/usr/bin/rm -rf /tmp/{{ ray_service_name }}
Restart=on-failure

Environment=TMPDIR=/tmp/{{ ray_service_name }}
StandardOutput=append:/var/log/{{ ray_service_name }}.log
StandardError=append:/var/log/{{ ray_service_name }}.log

# Ray needs high limits
TasksMax=infinity
LimitNPROC=infinity
LimitNOFILE=1048576 # linux default max
LimitSTACK=8388608
MemoryMax=infinity

[Install]
WantedBy=multi-user.target