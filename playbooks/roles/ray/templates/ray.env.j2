{% if ray_head_node %}
# For head node
{% if (ray_head_node_port | length) > 0 %}
RAY_PORT="{{ ray_head_node_port }}"
{% endif %}
{% if (ray_client_server_port | length) > 0 %}
RAY_CLIENT_SERVER_PORT="{{ ray_client_server_port }}"
{% endif %}
{% if (ray_internal_ip | length) > 0 %}
RAY_DASHBOARD_HOST="{{ ray_internal_ip }}"
{% endif %}
{% if (ray_dashboard_port | length) > 0 %}
RAY_DASHBOARD_PORT="{{ ray_dashboard_port }}"
{% endif %}
{% endif %}

RAY_LOG_TO_STDERR=1
RAY_BACKEND_LOG_LEVEL=debug
{% if (ray_connect_address | length) > 0 %}
# Which address to connect to the head node:
RAY_ADDRESS="{{ ray_connect_address  }}"
{% elif (ray_head_node_port | length) > 0 %}
RAY_PORT="{{ ray_head_node_port  }}"
{% endif %}
{% if (ray_internal_ip | length) > 0 %}
# Which ip address to bind to internally:
RAY_NODE_IP_ADDRESS="{{ ray_internal_ip }}"
{% endif %}

{% if (ray_auth_token | length) > 0 %}
RAY_AUTH_MODE=token
RAY_AUTH_TOKEN_PATH=/home/ray/ray_auth_token
{% endif %}

# User overrides and extras
{{ ray_env | split(",") | join("\n") }}
